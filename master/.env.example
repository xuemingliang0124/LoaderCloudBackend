# 应用
DEBUG=true
SECRET_KEY=change-me-in-production

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ptp
MYSQL_PASSWORD=ptp123456
MYSQL_DB=ptp

# Elasticsearch
ES_URL=http://127.0.0.1:9200
ES_INDEX_PREFIX=pt
ES_METRICS_RETENTION_DAYS=90

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
# presigned URL 对外地址（Agent 侧可达，如宿主机 IP:9000）；空则用 MINIO_ENDPOINT
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ptp
MINIO_SECURE=false

# Agent 通信
AGENT_HEARTBEAT_INTERVAL=10
AGENT_OFFLINE_THRESHOLD=3

# 调度
SCHEDULER_ENABLED=true
