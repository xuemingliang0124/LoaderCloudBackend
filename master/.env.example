# 应用
DEBUG=true
SECRET_KEY=change-me-in-production

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ptp
MYSQL_PASSWORD=ptp123456
MYSQL_DB=ptp

# Elasticsearch
ES_URL=http://127.0.0.1:9200
ES_INDEX_PREFIX=pt
ES_METRICS_RETENTION_DAYS=90

# 向量库（D2 引入：RAG 语义检索；ES 不再承担 dense_vector 职责）
# VECTOR_PROVIDER：qdrant（当前实现）/ milvus（待实现）
VECTOR_PROVIDER=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pt_knowledge
# embedding 向量维度；须与 D4 Embedding 模型输出一致（智谱 embedding-3 / 阿里 text-embedding-v3 均为 1024）
EMBEDDING_DIMS=1024

# Embedding 调用层（D4 引入）
# EMBEDDING_PROVIDER：zhipu | dashscope；空且未配 BASE_URL 视为未启用
# NFR-01 降级：未启用时改用 langchain FakeEmbeddings 入库（indexed=true, degraded=true）
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3

# LLM 调用层（P3 Stage 2 引入，FR-07）
# LLM_PROVIDER：zhipu | dashscope；空且未配 BASE_URL + API_KEY 视为未启用
# NFR-01 降级：未启用时改用 langchain FakeListChatModel 返回兜底 JSON
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=30

# RAG 调优参数（P3 Stage 1/2 引入）
# 文本切块大小/重叠（FR-03，RecursiveCharacterTextSplitter 用）
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 检索返回数 / 相似度阈值（FR-05）
TOP_K=5
SIMILARITY_THRESHOLD=0.5
# 是否启用 BM25 混检（EnsembleRetriever）
USE_BM25=false
# Prompt context 最大字符数（FR-06）
MAX_CONTEXT_CHARS=1800
# 指标校验容差（FR-08，|llm - actual| / actual > tolerance 视为不一致）
METRIC_TOLERANCE=0.05

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
# presigned URL 对外地址（Agent 侧可达，如宿主机 IP:9000）；空则用 MINIO_ENDPOINT
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ptp
MINIO_SECURE=false

# Agent 通信
AGENT_HEARTBEAT_INTERVAL=10
AGENT_OFFLINE_THRESHOLD=3
# 停止等待 Agent 回报终态的超时秒数（看门狗兜底强制置 STOPPED）
STOP_WAIT_TIMEOUT=90

# 调度
SCHEDULER_ENABLED=true
