// Jenkins Pipeline：Master 接口测试流水线（pytest + httpx，内存 SQLite，无外部依赖）
//
// 触发方式：
//   1) 由主流水线 Jenkinsfile 在镜像推送后通过 build step 自动触发（推荐）
//   2) 手动在 Jenkins UI 点击 Build（IMAGE_TAG 填 ACR 上已存在的 tag，如 latest）
//
// 测试环境说明：
//   - 直接 pull 主流水线构建好的 ptp-master 镜像，不重复构建（省时）
//   - 镜像内自带 tests/ 与 pytest.ini，与 app 代码同一次构建产出，版本严格一致
//   - 覆盖 entrypoint 直接跑 pytest；测试用 aiosqlite 内存库，无需 MySQL/MinIO/ES
//
// 前置条件（Jenkins 凭据配置）：
//   1) ACR_DOCKER_CONFIG — Secret file，docker login 后的 config.json（pull 私有镜像用）
//
// 产物：
//   - reports/test_report.html  — pytest-html 自包含 HTML 报告（可直接邮件发送）
//   - reports/junit.xml         — JUnit XML，供 Jenkins 展示趋势图与失败用例

pipeline {
    agent any

    parameters {
        // 上游 master 流水线传入的镜像 tag（必须是已 push 到 ACR 的版本）
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'ACR 上的 ptp-master 镜像 tag（上游自动传入，手动构建时填已存在的 tag）')
    }

    environment {
        // 与主流水线保持一致的 ACR 命名空间
        REGISTRY    = 'registry.cn-beijing.aliyuncs.com/xml066'
        // 被测镜像 = 主流水线已推送的那个，测试代码随镜像一起分发
        TEST_IMAGE  = "${REGISTRY}/ptp-master:${params.IMAGE_TAG}"
    }

    stages {
        stage('Pull Test Image') {
            steps {
                script {
                    // 复用主流水线已推送的镜像，不再 docker build
                    withCredentials([file(credentialsId: 'ACR_DOCKER_CONFIG', variable: 'DOCKER_CONFIG_FILE')]) {
                        sh '''
                            mkdir -p ~/.docker
                            cp "$DOCKER_CONFIG_FILE" ~/.docker/config.json
                            chmod 600 ~/.docker/config.json
                            docker pull "$TEST_IMAGE"
                        '''
                    }
                }
            }
        }

        stage('Run API Tests') {
            steps {
                sh '''
                    set -e
                    mkdir -p reports

                    # 容器内执行 pytest（tests/ 已在镜像内，无需挂载源码）：
                    #   -v 挂载 reports/（读写）接收报告产物
                    #   -w /app  工作目录，保证 `from app.xxx import` 可解析
                    #   --entrypoint python  覆盖默认 entrypoint（默认跑 alembic 迁移，测试不需要）
                    #   测试用内存 SQLite，不连接任何外部服务
                    docker run --rm \\
                        -v "$(pwd)/reports:/app/reports" \\
                        -w /app \\
                        --entrypoint python \\
                        "$TEST_IMAGE" \\
                        -m pytest tests/ -v \\
                            --html=reports/test_report.html \\
                            --self-contained-html \\
                            --junitxml=reports/junit.xml
                '''
            }
        }
    }

    post {
        always {
            // JUnit 结果：Jenkins 内置支持，展示通过/失败趋势图与失败用例详情
            // （如未安装 JUnit Plugin，请在 Jenkins 插件管理中安装 "JUnit"）
            junit testResults: 'reports/junit.xml', allowEmptyResults: true

            // 归档 HTML 报告与 JUnit XML，可在构建详情页 "Artifacts" 下载查看
            archiveArtifacts artifacts: 'reports/**/*', allowEmptyArchive: true

            // 清理本次 pull 的镜像
            sh 'docker image rm "$TEST_IMAGE" || true'
        }
        success {
            echo '✅ 接口测试全部通过'
        }
        failure {
            echo '❌ 接口测试存在失败用例，请查看上方日志、JUnit 结果或归档的 HTML 报告'
        }
    }
}
