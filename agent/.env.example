# Master WebSocket 地址（含端点路径）
MASTER_WS_URL=ws://127.0.0.1:8000/ws/agent

# Agent 标识：留空则启动时按宿主机 IP 向 Master 注册，自动分配并持久化固定 ID
AGENT_ID=
# 逗号分隔分组标签
TAGS=default

# JMeter 可执行文件
JMETER_BIN=jmeter
WORK_DIR=./agent_workspace
# 运行期插件目录（Master 下发的第三方插件 jar 落地处，通过 search_paths 注入）；
# 留空则默认 WORK_DIR/plugins
PLUGIN_DIR=

HEARTBEAT_INTERVAL=10
METRICS_INTERVAL=5
RECONNECT_DELAY_MAX=30
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
